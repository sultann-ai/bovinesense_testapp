# Copy to .env.local and fill in. Never commit .env.local.
# Supabase values: Project Settings -> API (or "API Keys") in the dashboard.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL, e.g. https://abcdefghijklmnop.supabase.co  (public)
NEXT_PUBLIC_SUPABASE_URL=

# anon / publishable key (public; safe in the browser, limited by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role / secret key. SERVER ONLY. Bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_, never import it from client code.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of this app, used as the password-reset / invitation link target when the
# request carries no Origin header (and by `npm run invite`). No trailing slash.
# It must also be listed under Authentication -> URL Configuration in the Supabase dashboard.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Google Maps (docs/MAP_STYLE.md) ─────────────────────────────────────────
# Browser key for the Maps JavaScript API. It ships to the browser, so RESTRICT it in Google Cloud
# Console: HTTP referrers = your own domains only, API = Maps JavaScript API only, one key per
# environment, with a budget alert and a daily map-load quota. Never commit a real value.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID (Map type: JavaScript, Vector) with the cream style attached; see docs/MAP_STYLE.md.
NEXT_PUBLIC_GOOGLE_MAP_ID=

# ─── Ingestion ───────────────────────────────────────────────────────────────
# There is no shared ingest secret any more: each organization has its own device keys
# (Settings -> Device keys, or `npm run device-key -- create --org <slug> --label <name>`).
# Optional, for scripts/simulate.ts only:
# Where the simulator posts fixes; defaults to http://localhost:3000/api/ingest/fix
INGEST_URL=
# A device key for the simulator to use (or pass --key). Without one it mints a temporary key
# for the run and revokes it when it stops. Keep real keys out of files you commit.
DEVICE_API_KEY=


# ─── Demo ────────────────────────────────────────────────────────────────────
# Serial number of the one real tag; `npm run seed:real-tag` reserves its slot in Bank of Punjab.
REAL_TAG_SERIAL=
# Optional: fixes one device key may send per minute to /api/ingest/fix (default 3000).
INGEST_RATE_LIMIT_PER_MIN=
